# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------------------
# OpenAI (single provider — all calls go through src/providers/openai.js)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=

# Model names. Overridable per-environment in case a store needs to pin an
# older/newer snapshot without touching code.
OPENAI_MODEL_TERRA=gpt-5.6-terra
OPENAI_MODEL_LUNA=gpt-5.6-luna
OPENAI_MODEL_IMAGE=gpt-image-1.5
OPENAI_MODEL_IMAGE_EDIT=gpt-image-1
OPENAI_MODEL_EMBEDDING=text-embedding-3-small

# ---------------------------------------------------------------------------
# Supabase (server-side only — SECRET key, never the anon/public key)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Shopify custom app — client credentials grant (token auto-refreshes, 24h TTL)
# ---------------------------------------------------------------------------
# e.g. collagenlab.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# The customer-facing storefront domain (NOT the *.myshopify.com admin domain
# above, and not necessarily the shop's primary domain either — check what
# domain a real product's onlineStoreUrl actually resolves on). Used to build
# public article URLs (src/steps/publish.js) since Shopify's Admin API has no
# onlineStoreUrl field for articles. e.g. collagenlab.bg
STORE_PUBLIC_DOMAIN=

# The blog to publish articles into (Shopify GID, e.g. gid://shopify/Blog/123456789).
# Leave blank for the first run — publish.js will fetch and log the store's default
# blog's GID so you can copy it here for subsequent runs.
BLOG_GID_COLLAGENLAB=

# Fallback product handle used when matchProduct.js finds no semantic match
# confident enough to clear the guards, so every article still carries a
# product link (src/steps/matchProduct.js's fetchPrimaryProduct()). Leave
# blank to fall back to the hardcoded default in src/config.js.
PRIMARY_PRODUCT_HANDLE_COLLAGENLAB=

# ---------------------------------------------------------------------------
# Pipeline behavior
# ---------------------------------------------------------------------------
# log   = record EU health-claim (EC 1924/2006) violations but publish anyway
# block = refuse to publish an article that fails the compliance scan
# off   = skip the compliance step entirely
COMPLIANCE_MODE=block

# How many articles src/index.js generates per invocation
ARTICLES_PER_RUN=1

# draft     = create articles unpublished, for manual review in Shopify admin
# published = go live immediately on creation
PUBLISH_STATUS=draft

# ---------------------------------------------------------------------------
# Internal linking (src/steps/linkProducts.js)
# ---------------------------------------------------------------------------
# Minimum cosine similarity for a product match to be linked as "related".
LINK_MIN_SIMILARITY=0.35

# Comma-separated, case-insensitive substrings. A product whose title/type
# matches one of these is an accessory (not a supplement) and is never linked
# as a related product.
ACCESSORY_KEYWORDS=spoon,scoop,лъжичка,мерителна,аксесоар,accessory

# ---------------------------------------------------------------------------
# Featured image (src/steps/generateImage.js)
# ---------------------------------------------------------------------------
# Blog thumbnail, not a hero image — keep modest for cost control.
IMAGE_SIZE=1024x1024
IMAGE_QUALITY=medium
# Test/trial-run only — forces a specific product flavor (slug from config.image.flavors)
# instead of picking one at random per article. Leave unset in normal operation.
# IMAGE_FORCE_FLAVOR=original
