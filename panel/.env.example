# Stores (domain, Client ID, Client secret) are added in the panel: npm run dev → Магазини → Добави магазин,
# or imported once from the blog pipeline's .env with npm run import-stores. Nothing store-specific goes here.

# The shared Supabase project (same as the blog pipeline in ../.env). Server-side secret key only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Encrypts Client secrets in the `stores` table (32 random bytes, base64): npm run gen-key.
# Required. The blog pipeline needs the same value (GitHub secret CREDENTIALS_KEY) to read them.
CREDENTIALS_KEY=

# Claude API, for translation. Alternatively log in with `ant auth login` and leave this empty.
ANTHROPIC_API_KEY=

# Comma-separated, case-sensitive terms that are never translated (Phase 0 only; later from the glossary).
NEVER_TRANSLATE=CollagenLab,Nutrikal

# Optional. The blog pipeline's stores/ folder, for the "not in the panel yet" list. Default: ../stores
PIPELINE_STORES_DIR=
